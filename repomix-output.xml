package de.langerhans.odintools.data

import android.content.Context
import androidx.room.Room
import dagger.Module
import dagger.Provides
import dagger.hilt.InstallIn
import dagger.hilt.android.qualifiers.ApplicationContext
import dagger.hilt.components.SingletonComponent
import javax.inject.Singleton

@InstallIn(SingletonComponent::class)
@Module
class DatabaseModule {

    @Provides
    fun provideAppOverrideDao(db: AppDatabase): AppOverrideDao {
        return db.appOverrideDao()
    }

    @Provides
    @Singleton
    fun provideAppDatabase(@ApplicationContext appContext: Context): AppDatabase {
        return Room.databaseBuilder(
            appContext,
            AppDatabase::class.java,
            "app",
        )
            .fallbackToDestructiveMigration() // Limpa os dados obsoletos e recria a tabela com as novas colunas
            .build()
    }
}
